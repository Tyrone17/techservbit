<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>techservit</title>
    <link rel="stylesheet" href="/style.css" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/marked/marked.min.js">
    </script>
  </head>
  <body class="body-container" >
    <%- include('../public/partials/header.ejs') %>
    <div class="container">
      <div class="viewBlog-header">
        <h1 class="title text-left"><%=  %></h1>
      </div>
      <div class="overflow-div">

        <% if(blogDetails) {%>
        <p><% blogDetails %></p>
        <% } else if( posts ) {%>
        <!-- <p>Posts work</p> -->
        <!-- <p><%= posts%></p> -->
        <% for( let index=0; index < posts.length; index++ ) { %>
          <% if (posts[index]._id.toString() == currentUrl.slice(currentUrl.length-24,currentUrl.length)) { %>
            <h2><%= posts[index].articleTitle%></h2>
            <h4>written by: <%= posts[index].author%></h4>
            <h5>written on: <%= posts[index].dateCreated%></h5>
            <p id="aContent"><%= posts[index].articleContent%></p>
            <h6>source: <%= posts[index].source %></h6>
            <p  id="bContent"></p>
            
            <%}%>
            <%}%>
            <!-- <p>Debug: Current URL is <%= currentUrl %></p> -->
        <%  } else {%>
        <p>Nope</p>
        <%}%>
      </div>
    </div>
    <script type="module" src="/public/display.js">
      
    </script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/marked/marked.min.js">
    </script>

    <%- include('../public/partials/footer.ejs') %>
  </body>
</html>
